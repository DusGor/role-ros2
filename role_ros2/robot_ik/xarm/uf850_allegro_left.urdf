  <!-- Lab wrist adapter plate (flange -> Allegro hand) and camera holder.
       connector_xyz/rpy and camera_rpy differ per side and have no defaults.
       hand_mount_xyz/rpy: CAD connector -> palm pose, composed with the inverse of
       the Allegro macro's 0.095 m base_link -> palm_link offset. -->
  <!-- Adapter plate -->
  <link name="hand_connector">
    <visual>
      <geometry>
        <mesh filename="package://role_ros2/robot_ik/xarm/meshes/visual/final_connector.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="lab_adapter_red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://role_ros2/robot_ik/xarm/meshes/collision/final_connector.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-5" ixy="0.0" ixz="0.0" iyy="1e-5" iyz="0.0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="link_eef_to_hand_connector_joint" type="fixed">
    <parent link="link_eef"/>
    <child link="hand_connector"/>
    <origin rpy="0 0 0" xyz="-0.05 -0.025 0.003"/>
  </joint>
  <joint name="hand_connector_to_hand_mount_joint" type="fixed">
    <parent link="hand_connector"/>
    <child link="hand_base_link"/>
    <origin rpy="0 -1.57 1.57" xyz="0.05007565 0.08399994 0.05892435"/>
  </joint>
  <link name="camera_connector">
    <visual>
      <geometry>
        <mesh filename="package://role_ros2/robot_ik/xarm/meshes/visual/camera_holder.stl"/>
      </geometry>
      <material name="lab_adapter_red"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://role_ros2/robot_ik/xarm/meshes/collision/camera_holder.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="camera_connector_to_link_eef_joint" type="fixed">
    <parent link="link_eef"/>
    <child link="camera_connector"/>
    <origin rpy="3.14 0 -0.8" xyz="0 0 0.003"/>
  </joint>
  <!-- Camera mount point -->
  <link name="camera_virtual_base"/>
  <joint name="camera_connector_to_camera_virtual_base_joint" type="fixed">
    <parent link="camera_connector"/>
    <child link="camera_virtual_base"/>
    <origin rpy="0 0.785 0" xyz="-0.11 0 -0.07"/>
  </joint>
</robot>
